#!/bin/sh

# The strict-mode header below is set -eu rather than the set -Eeuo pipefail the shell-codestyle rule states.
# This hook is an sh script rather than a Bash one, and neither -E nor pipefail is POSIX.
# The header also sits below the source line, because husky.sh is generated code this hook does not control and -u would fail on any unset variable it reads.
# That leaves the source itself unguarded, so the file is checked explicitly rather than relying on a set -e that is not on yet.
husky_sh="$(dirname "$0")/_/husky.sh"
if [ ! -f "$husky_sh" ]; then
    echo "pre-commit: $husky_sh is missing, so this clone has no Husky runtime." >&2
    echo "pre-commit: run 'dotnet tool restore' then 'dotnet husky install' from the repo root." >&2
    exit 1
fi
# shellcheck disable=SC1090,SC1091  # Generated by Husky install, so it is absent at lint time.
. "$husky_sh"
set -eu

# Local pre-commit: language formatting and style only, and no Docker.
# The full lint set runs in CI and the VS Code Lint tasks.

# .NET runs CSharpier and dotnet format style via Husky.Net.
# A Python repo runs ruff here instead.
if command -v dotnet >/dev/null 2>&1; then
    dotnet husky run
fi
