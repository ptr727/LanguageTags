#!/bin/sh
# shellcheck disable=SC1091  # Generated by Husky install, not present at lint time.
. "$(dirname "$0")/_/husky.sh"

# The header below is set -eu rather than the set -Eeuo pipefail the shell-codestyle rule states for a Bash script.
# This hook runs under the #!/bin/sh of the fleet's own Husky snippet, where -E and pipefail are not POSIX and dash rejects them.
# It sits below the source line because husky.sh is generated code this hook does not control, and -u would fail on any unset variable it reads.
set -eu

# Local pre-commit: language formatting and style only, and no Docker.
# The full lint set runs in CI and the VS Code Lint tasks.

# .NET: CSharpier + dotnet format style via Husky.Net. A Python repo runs ruff here instead.
if command -v dotnet >/dev/null 2>&1; then
    dotnet husky run
fi
